  {
   "id": "t19",
   "type": "text",
   "x": 80,
   "y": 450,
   "width": 1809.5000000000002,
   "height": 36.4,
   "text": "Green = study.best_trials: no other trial is better on one objective without being worse on the other.\nGrey = dominated: some trial beats it on both (or ties one, beats the other). You pick ON the front; where depends on your priority.",
   "originalText": "Green = study.best_trials: no other trial is better on one objective without being worse on the other.\nGrey = dominated: some trial beats it on both (or ties one, beats the other). You pick ON the front; where depends on your priority.",
