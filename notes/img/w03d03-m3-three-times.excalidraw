   "y": 58,
   "width": 270,
   "height": 18.75,
   "backgroundColor": "transparent",
   "roundness": null,
   "text": "B. INGEST (your code, once)",
   "originalText": "B. INGEST (your code, once)",
   "fontSize": 15,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "baseline": 15
  },
  {
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "seed": 1,
