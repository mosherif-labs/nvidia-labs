   "locked": false,
   "id": "e964059725",
   "type": "text",
   "x": 330,
   "y": 95,
   "width": 265,
   "height": 140.0,
   "backgroundColor": "transparent",
   "roundness": null,
   "text": "For each chunk of YOUR docs:\n  v = f(chunk)   # NIM call\n  Milvus.insert(v, text, status)\n\nWeights don't change.\nThis is inference, not training:\nlike calling a hash function\nand storing the result.",
   "originalText": "For each chunk of YOUR docs:\n  v = f(chunk)   # NIM call\n  Milvus.insert(v, text, status)\n\nWeights don't change.\nThis is inference, not training:\nlike calling a hash function\nand storing the result.",
   "fontSize": 14,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "baseline": 14
  },
