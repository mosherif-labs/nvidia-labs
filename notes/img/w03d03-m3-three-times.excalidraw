   "id": "e908088444",
   "type": "text",
   "x": 630,
   "y": 95,
   "width": 265,
   "height": 157.5,
   "backgroundColor": "transparent",
   "roundness": null,
   "text": "q = f(question)\nhits = Milvus nearest(q, top 5,\n         status == current)\nprompt = hits + question\nanswer = LLM(prompt)\n\nThe LLM never saw your docs\nin training. It sees them\nonly in this prompt.",
   "originalText": "q = f(question)\nhits = Milvus nearest(q, top 5,\n         status == current)\nprompt = hits + question\nanswer = LLM(prompt)\n\nThe LLM never saw your docs\nin training. It sees them\nonly in this prompt.",
   "fontSize": 14,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
