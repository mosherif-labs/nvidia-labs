   "width": 900,
   "height": 37.5,
   "backgroundColor": "transparent",
   "roundness": null,
   "text": "Don't confuse: the LLM ALSO has an internal embedding layer (token embeddings, learned in its training).\nThat lives inside the LLM and isn't searchable. RAG uses a SEPARATE embedding model + a vector DB you own.",
   "originalText": "Don't confuse: the LLM ALSO has an internal embedding layer (token embeddings, learned in its training).\nThat lives inside the LLM and isn't searchable. RAG uses a SEPARATE embedding model + a vector DB you own.",
