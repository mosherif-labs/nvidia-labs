   "height": 18.75,
   "backgroundColor": "transparent",
   "roundness": null,
   "text": "A. TRAINING  (NVIDIA, months ago)",
   "originalText": "A. TRAINING  (NVIDIA, months ago)",
   "fontSize": 15,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "baseline": 15
  },
  {
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "seed": 1,
   "version": 1,
   "versionNonce": 1,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "id": "e612838384",
   "type": "text",
   "x": 30,
   "y": 95,
   "width": 265,
   "height": 157.5,
   "backgroundColor": "transparent",
   "roundness": null,
   "text": "Millions of (question, passage)\npairs teach the model WEIGHTS:\nhow to turn any text into a\nvector so similar meanings\nland close together.\n\nResult: a frozen function\nf(text) -> 2048 numbers.\nYou never do this step.",
   "originalText": "Millions of (question, passage)\npairs teach the model WEIGHTS:\nhow to turn any text into a\nvector so similar meanings\nland close together.\n\nResult: a frozen function\nf(text) -> 2048 numbers.\nYou never do this step.",
   "fontSize": 14,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "baseline": 14
  },
  {
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "fillStyle": "solid",
