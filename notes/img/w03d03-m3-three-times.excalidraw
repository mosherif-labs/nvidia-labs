   "backgroundColor": "transparent",
   "roundness": null,
   "text": "C. QUERY (your code, per question)",
   "originalText": "C. QUERY (your code, per question)",
   "fontSize": 15,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "baseline": 15
  },
  {
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
